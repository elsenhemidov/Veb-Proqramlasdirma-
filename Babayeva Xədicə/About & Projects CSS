/* About Section */
.about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    align-items: center;
    gap: 48px;
}

.list-columns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 32px;
}

.check-list,
.number-list {
    margin: 0;
    padding-left: 22px;
    color: var(--gray-600);
}

.check-list li,
.number-list li {
    margin-bottom: 10px;
}

.stats-panel {
    display: grid;
    gap: 18px;
    padding: 22px;
    border-radius: var(--radius);
    background: var(--navy);
    box-shadow: var(--shadow);
}

.stat-card {
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.06);
}

.stat-card strong,
.stat-card span {
    display: block;
}

.stat-card strong {
    color: var(--cyan);
    font-size: 2.4rem;
    line-height: 1;
}

.stat-card span {
    margin-top: 8px;
    color: var(--white);
    font-weight: 700;
}

/* Projects Section */
.projects {
    background: linear-gradient(180deg, var(--gray-50), var(--white));
}

.project-grid {
    grid-template-columns: repeat(3, 1fr);
}

.project-card {
    border: 1px solid var(--gray-100);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: 0 10px 30px rgba(7, 26, 47, 0.08);
    overflow: hidden;
}

.project-card img {
    width: 100%;
    height: 230px;
    object-fit: cover;
}

.project-body {
    padding: 24px;
}

.project-body a {
    color: var(--blue);
    font-weight: 800;
}

.project-body a:hover {
    color: var(--teal);
}
